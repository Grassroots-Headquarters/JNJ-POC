# Copy to .env.local. Local values come from `pnpm supabase status` (scripts/dev.sh writes them for you).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Leave empty to switch Sentry off.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only: uploads source maps when set. Optional.
SENTRY_AUTH_TOKEN=
# Set by the build: admin@<commit sha> on Vercel and in CI. Leave unset locally.
# NEXT_PUBLIC_SENTRY_RELEASE=
