# Local Edge Function secrets. Copy to supabase/functions/.env (git-ignored).
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by the runtime.
# Leave STRIPE_SECRET_KEY empty locally: billing-checkout and billing-portal then answer 503
# and the webhook skips the Stripe API calls (the Referral reward row is still written).
STRIPE_SECRET_KEY=
# Local-only signing secret: the integration tests sign their test events with this same value
# (integration/tests/billing.test.ts reads it from this file). Any whsec_ string works; never a real one.
STRIPE_WEBHOOK_SECRET=whsec_local_test_only_my_builder_app
STRIPE_CLIENT_PORTAL_PRICE_ID=
# Leave TWILIO_ACCOUNT_SID empty locally: Invite SMS are then recorded in outbound_sms instead of sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
INVITE_LINK_BASE_URL=https://app.example.com
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_ENVIRONMENT=local
