{
  "name": "jnj-site-app",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:db": "supabase test db",
    "test:e2e": "pnpm --filter @jnj/e2e test",
    "gen:types": "supabase gen types typescript --local > packages/shared/src/database.types.ts",
    "supabase": "supabase"
  },
  "devDependencies": {
    "supabase": "2.122.0",
    "typescript": "~6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
